include LICENSE
include README.md
include CHANGELOG.md
include SECURITY.md
include requirements.txt
include .env.example
graft appmanager/templates
graft appmanager/static
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .env*
global-exclude *.db
global-exclude *.sqlite*
prune instance
prune installed_apps
prune .venv
prune .pytest_cache
