# ==============================================================================
# AppManager Configuration
# Copy this file to .env and adjust the values as needed.
# ==============================================================================

# Core Application Security
# IMPORTANT: Generate strong random secrets for production!
#   `appmanager generate-tokens --env` prints ready-to-paste values.
# In production (APPMANAGER_ENV=production) the server REFUSES to boot if these
# are left at their development defaults or shorter than 32 chars.
SECRET_KEY=appmanager-change-this-to-a-secure-random-string-in-production-min-32-chars
JWT_SECRET=jwt-change-this-to-a-secure-random-string-in-production-min-32-chars
AIC_TOKEN_SECRET=aic-token-secret-change-this-to-a-secure-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7
MAGIC_LINK_EXPIRES_MINUTES=15

# Optional: shared secret for signing forwarded sub-app identity headers.
# When set here, the dispatcher adds X-AppManager-Signature (HMAC-SHA256 over
# "user_id|email|role"). Sub-apps must set the SAME value as
# APPMANAGER_HEADER_SECRET (or pass header_secret= to AppManagerClient) to verify
# it. Leave empty for the default gateway-only trust model.
# APPMANAGER_HEADER_SECRET=

# Deployment environment: development | production.
# Setting 'production' enables the insecure-secret startup guard above.
APPMANAGER_ENV=development

# Server & Host URL
APP_BASE_URL=http://localhost:5000
PORT=5000
HOST=0.0.0.0
TEMPLATES_AUTO_RELOAD=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Database Configuration (SQLite default, PostgreSQL/MySQL supported)
# Examples:
#   SQLite: sqlite:///instance/appmanager.db
#   PostgreSQL: postgresql://user:password@localhost:5432/appmanager
#   MySQL: mysql+pymysql://user:password@localhost:3306/appmanager
DATABASE_URL=sqlite:///instance/appmanager.db

# Storage Directories
# INSTALLED_APPS_DIR=./installed_apps
# TEMP_UPLOAD_DIR=./instance/uploads

# Google OAuth 2.0 (Optional - for Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# SMTP Email Configuration (Required for Magic Link email delivery in production)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@appmanager.local

# Developer Magic Login (Set to true to show one-click login button when SMTP is disabled)
ALLOW_DEV_MAGIC_LOGIN=false
DEBUG_LOGIN=false

# Role & Admin Provisioning
# FIRST_USER_IS_ADMIN: If true, the very first user who registers will be granted the admin role
FIRST_USER_IS_ADMIN=true
# ADMIN_EMAILS: Comma-separated list of emails that automatically receive admin role upon registration
ADMIN_EMAILS=
